rules_version = '2';
// BAEK TO YOU — Firestore 보안 규칙
// · content/main (+chunks), photos/{id}: 누구나 읽기 · 관리자만 쓰기/삭제
// · admins/{uid}: 본인 것만 읽기 (관리자 여부 확인용) · 앱에서는 절대 쓰기 불가 → Firebase 콘솔에서만 만듦
// · users/{uid}/**: 본인만 읽기/쓰기 — 관리자도 다른 사용자 데이터는 못 읽고 못 씀
// · 그 밖의 경로: 모두 거부
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /content/{doc} {
      allow read: if true;
      allow write: if isAdmin();
      match /chunks/{chunk} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /photos/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
    }

    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /chunks/{chunk} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
